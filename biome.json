{
  "files": {
    "includes": [
      "**/*.js",
      "**/*.mjs",
      "**/*.ts",
      "**/*.tsx",
      "!**/node_modules",
      "!**/dist",
      "!**/.wrangler",
      "!**/target",
      "!**/export-bridge/pkg",
      "!**/*.generated.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            "hooks": [
              {
                "name": "useProjectStore",
                "stableResult": [
                  "dispatchProjectHistory",
                  "setPlayheadQState",
                  "playheadQRef",
                  "setWorkspaceAccess",
                  "isWorkspaceReadOnlyRef",
                  "setIsTakeOverPromptOpen",
                  "projectSnapshotRef"
                ]
              }
            ]
          }
        }
      }
    }
  }
}
