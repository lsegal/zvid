{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zvid",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-22",
  // Builds the app and adds the ZVID Capture installers from the latest
  // successful DAW bundles run on main (scripts/fetch-capture-installers.ts).
  "build": {
    "command": "pnpm run cf:prepare"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // The ZVID Capture installers, served under /downloads by
  // worker/downloads.ts. They exceed the 25 MiB static asset limit.
  // scripts/fetch-capture-installers.ts uploads them; keep its BUCKET in sync.
  "r2_buckets": [
    {
      "binding": "CAPTURE_INSTALLERS",
      "bucket_name": "zvid-downloads"
    }
  ],
  // Caps TURN credential minting at /api/ice-servers per client IP
  // (worker/turn.ts). Keep `period` in sync with
  // TURN_RATE_LIMIT_PERIOD_SECONDS.
  "ratelimits": [
    {
      "name": "TURN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "previews": {}
}
