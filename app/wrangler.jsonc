{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zvid",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-22",
  // Serves the app at use.zvid.app as well as the workers.dev origin.
  // `wrangler deploy` creates or updates the route. Unlike a custom domain,
  // a route doesn't create its own DNS record: use.zvid.app needs a proxied
  // record in the zvid.app zone (e.g. AAAA to 100::) for requests to reach it.
  "routes": [{ "pattern": "use.zvid.app/*", "zone_name": "zvid.app" }],
  // Adding routes turns workers.dev off unless it's set. The native app's
  // ICE server default (src/ice-servers.ts), its CSP
  // (src-tauri/tauri.conf.json) and the Deploy workflow's installer check
  // all use https://zvid.lsegal.workers.dev.
  "workers_dev": true,
  "build": {
    "command": "pnpm run cf:prepare"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without these, Cloudflare answers navigations (a clicked installer
    // link, a URL typed into the address bar) with the SPA's index.html
    // before the Worker runs, so the Worker routes below would only see
    // fetches. The Worker hands every other /api/* path back to ASSETS.
    "run_worker_first": ["/downloads/*", "/api/*"]
  },
  // The ZVID Capture installers and their manifest, which the DAW bundles
  // workflow publishes on every merge to main; worker/downloads.ts serves
  // them at /downloads/*.
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "zvid-downloads" }],
  // Caps TURN credential minting at /api/ice-servers per client IP
  // (worker/turn.ts). Keep `period` in sync with
  // TURN_RATE_LIMIT_PERIOD_SECONDS.
  "ratelimits": [
    {
      "name": "TURN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "previews": {}
}
