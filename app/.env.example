# WebRTC signaling endpoint. Defaults to the public y-webrtc relay so zvid
# collaboration works out of the box. Point this at your own deployed Cloudflare
# Worker (see ../signaling) or `wrangler dev`'s local URL if you'd rather
# self-host. Separate multiple endpoints with commas.
VITE_SIGNALING_URL=wss://y-webrtc-eu.fly.dev

# Public URL the app is served from, used as the base of collaboration share
# links. Leave unset to use the page's own origin; set it when the app is
# reached under a different public URL (e.g. behind a proxy or tunnel).
# VITE_PUBLIC_APP_URL=https://zvid.example.com/
