# WebRTC signaling endpoints, separated by commas. Defaults to zvid's own
# Cloudflare Worker (see ../signaling) with the public y-webrtc relay as a
# fallback. Point this at your own deployed Worker or `wrangler dev`'s local
# URL if you'd rather self-host.
VITE_SIGNALING_URL=wss://zvid-signaling.lsegal.workers.dev,wss://y-webrtc-eu.fly.dev

# ICE servers for the WebRTC connections, as a JSON array of RTCIceServer
# objects. Defaults to public STUN servers only, which can't connect peers
# behind symmetric NAT, CGNAT, mobile hotspots or strict firewalls; add a TURN
# server (e.g. Cloudflare Calls TURN, Twilio, or a self-hosted coturn) for
# those. Invalid JSON is logged and the defaults are used.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":["turn:turn.example.com:3478","turns:turn.example.com:5349"],"username":"zvid","credential":"secret"}]
