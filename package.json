{
  "name": "zvid",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "pnpm dlx pnpm@8 --dir app install --frozen-lockfile && pnpm dlx pnpm@8 --dir app run build",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:dry-run": "pnpm run build && wrangler deploy --dry-run",
    "dev": "pnpm -C app dev",
    "dev:native": "pnpm -C app tauri:dev",
    "lint": "pnpm --dir app exec tsc -b && biome check",
    "lint:fix": "biome check --unsafe --write",
    "test": "pnpm --dir app run test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "typescript": "^6.0.0",
    "wrangler": "^4.137.0"
  }
}
