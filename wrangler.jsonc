{
  "$schema": "./app/node_modules/wrangler/config-schema.json",
  "name": "zvid-app",
  "main": "./app/worker/index.ts",
  "compatibility_date": "2026-04-22",
  "assets": {
    "directory": "./app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "previews": {}
}
